# Kopiera den här filen till .env och fyll i dina egna uppgifter.
# .env checkas aldrig in i Git.
PORT=3000
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=geopass
DB_NAME=geoknowledge
# Sätts till true på Render, eftersom Aiven kräver SSL
DB_SSL=false
JWT_SECRET=byt-till-en-lång-slumpad-sträng
GOOGLE_CLIENT_ID=ditt-google-client-id
GOOGLE_CLIENT_SECRET=din-google-client-secret
# Adressen till frontend, utan / på slutet
FRONTEND_URL=http://localhost:5173
