# Kopiera den här filen till .env och fyll i dina egna uppgifter.
# .env checkas aldrig in i Git.
PORT=3000
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=geopass
DB_NAME=geoknowledge
# Sätts till true på Render, eftersom Aiven kräver SSL
DB_SSL=false
# Bara när DB_SSL=true: sökvägen till Aivens CA-certifikat
# DB_CA_PATH=
JWT_SECRET=byt-till-en-lång-slumpad-sträng
GOOGLE_CLIENT_ID=ditt-google-client-id
GOOGLE_CLIENT_SECRET=din-google-client-secret
# Adressen till frontend, utan / på slutet. Används för att skicka tillbaka
# användaren efter inloggningen, och för CORS: bara JavaScript på den här
# adressen får läsa API:ts svar i en webbläsare (lokalt godtas både localhost
# och 127.0.0.1). Byter Vite port måste den här ändras – därför startar Vite
# bara på 5173 (se frontend/vite.config.js).
FRONTEND_URL=http://localhost:5173
